# ===== 规划器指标版本 =====
# 根据 RequestLedger 记录的验证 HTTP 尝试次数划分为 3 个等级。
PLANNER_METRICS_VERSION=3

# ===== GitHub 构件搜寻器 =====
# 作为产品默认偏好启用；没有令牌和 DATABASE_URL 时实例仍不会执行任何操作。
GITHUB_HUNTER_ENABLED=true
# 逗号分隔的细粒度 PAT（建议仅授予 Contents 只读权限，且只访问公开仓库）。
GITHUB_TOKENS=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
# 每个规则包的提交消息分片预算（R3 多关键词查询需要 ≥8–10）。
GITHUB_COMMIT_QUERY_BUDGET=12
GITHUB_CODE_QUERY_BUDGET=8
GITHUB_SEARCH_PAGE_SIZE=100
GITHUB_MAX_PAGES_PER_SHARD=5
# 增量扫描：没有检查点水位时向前回溯的小时数。
GITHUB_LOOKBACK_HOURS=24
# 未设置 BACKFILL_FROM 的全量扫描：默认回溯 720 小时（30 天）。mode=full 始终忽略水位。
GITHUB_FULL_LOOKBACK_HOURS=720
# 全量回填的可选绝对起始时间（ISO 日期/日期时间，例如 2025-06-01）。
GITHUB_BACKFILL_FROM=
GITHUB_OVERLAP_MINUTES=15
GITHUB_REQUEST_TIMEOUT=20
GITHUB_ARTIFACT_CONCURRENCY=8
GITHUB_MAX_COMMIT_FILES=3000
GITHUB_MAX_BLOB_BYTES=1048576
GITHUB_BLOB_FALLBACK_BUDGET=100
GITHUB_FILE_HISTORY_ENABLED=true
GITHUB_FILE_HISTORY_COMMIT_LIMIT=100
# 当某资源的所有令牌冷却时间均超过此值时，跳过对应 GitHub 通道。
GITHUB_RATE_LIMIT_MAX_WAIT_SECONDS=90

# ===== FofoAPI 配置 =====
# 逗号分隔的 FOFA 密钥列表（轮换/故障回退）
FOFA_KEYS=your_fofa_key_1,your_fofa_key_2,your_fofa_key_3

# FOFA 代理的基础 URL（推荐 fofoapi.com，速度更快）
FOFA_BASE_URL=https://fofoapi.com

# 每次请求的分页大小（最大 100；包含 header/banner/cert 字段时应适当降低以确保稳定）
FOFA_PAGE_SIZE=100

# 每次查询的最大页数（除非使用付费服务，否则平台将总结果数限制为 10000）
FOFA_MAX_PAGES=10

# 请求超时时间（秒）
FOFA_TIMEOUT=30
# 为兼容早期部署保留。
FOFA_QUERY_CONCURRENCY=3
# FOFA 分页请求间隔（秒）。
FOFA_PAGE_DELAY=0.3

# 将计划搜索量的 20% 留给低收益查询的确定性探索。
QUERY_EXPLORATION_RATIO=0.2
# 增量扫描的查询表达式预算（全量扫描会执行所有查询）。
FOFA_QUERY_BUDGET=24
SHODAN_QUERY_BUDGET=16
# Shodan 国家分片组预计覆盖主机数的保守上限。
SHODAN_SHARD_HOST_BUDGET=1000

# 同时进行的主机探测（HTTP）数量。此值是信号量上限，不是任务总数。
PROBER_CONCURRENCY=50
# 每批调度为异步任务的主机数。大型扫描（1 万至 3 万台主机）会分批处理，
# 从而限制小型 VPS（例如 2 核 6GB）的内存峰值。若仍发生 OOM，请降低此值；
# 若服务器配置更高，可适当提高。
PROBER_BATCH_SIZE=200

# 验证探测并发数（同时进行的 HTTP 验证上限）
VALIDATE_CONCURRENCY=20
# 从 PostgreSQL 溢出存储执行验证时，每批加载/调度的凭据数。
VALIDATE_BATCH_SIZE=500
# UI 批量余额操作触发的供应商请求最大并发数。
# 每页最多可选择 50 条记录；小型 VPS 应采用较保守的值。
BALANCE_BATCH_CONCURRENCY=6

# 验证探测的请求超时时间
VALIDATE_TIMEOUT=15

# 小型 VPS（2 核 CPU / 6GB）示例——只调整并发；保留完整探测风险配置和 source=all
# PROBER_CONCURRENCY=6
# PROBER_BATCH_SIZE=100
# VALIDATE_CONCURRENCY=6
# VALIDATE_BATCH_SIZE=500
# GITHUB_ARTIFACT_CONCURRENCY=3

# 产品探测器对每个目标的 HTTP 请求预算（字典和 L0–L3 探测需要预留空间）。
MAX_REQUESTS_PER_TARGET=650
# 通用探测器的独立预算（重新获取/故障回退），与产品 L1+ 探测隔离。
GENERIC_MAX_REQUESTS_PER_TARGET=12
MAX_PROBE_REDIRECTS=2
MIN_PROBE_EVIDENCE_SCORE=50
#
# ⚠️  主动探测安全门控——本示例默认采用安全的“仅 L0”配置。
# L0 仅执行被动、未认证读取。启用下方任一选项会开启主动攻击行为
#（弱密码喷洒、IDOR、SSRF、SQL 注入、RCE），仅可用于已明确授权测试的目标。
# 切勿在全网扫描中启用。提高风险等级前，必须先在 AUTHORIZED_PROBE_SCOPE
# 中填写你拥有或获准测试的准确源地址。
#
# L1+（weak_password / IDOR / SSRF / SQLi / RCE）的总开关。
# false → 仅允许 L0 unauth_read（默认）；true → 按下方开关允许 L1+。
INTRUSIVE_CHECKS=false
# L1+ 必需的源地址白名单（逗号分隔的准确源地址，不含路径/查询参数）。
# 留空时始终安全回退至 L0，即使 INTRUSIVE_CHECKS=true 也是如此。
AUTHORIZED_PROBE_SCOPE=
# 密码字典（每行一个密码）。留空时使用随 Rust 包提供的资源：
#   crates/aipocket-prober/data/weak_passwords.txt
WEAK_PASSWORD_DICT_PATH=
# 每个字典密码尝试的用户名（顺序即优先级，admin 优先）。
WEAK_PASSWORD_USERNAMES=admin,root
# 每个目标尝试的（用户名, 密码）组合上限。0 表示完整字典 × 用户名（受预算限制）。
# 每个产品的弱密码 Spec 还会通过各自的 max_requests 限制请求数。
WEAK_PASSWORD_MAX_ATTEMPTS=0
# 漏洞类别白名单。类别：unauth_read,weak_password,idor,ssrf,sqli,rce（* 表示全部）。
# 未知或拼写错误的类别名会在启动时被拒绝（安全关闭）。
PROBE_VULN_CLASSES=*
# 最高风险等级：0=仅 L0，1=增加 L1 弱密码/IDOR，2=增加 L2 SSRF/SQL 注入，3=增加 L3 RCE。
# 各产品适配器会注册 L0–L3 Spec；此值与相关开关共同决定实际执行内容。
# 安全默认值为 0（仅 L0 被动读取）。只有获得授权后才能提高。
PROBE_MAX_RISK=0
# L2/L3 类别开关（还需 INTRUSIVE_CHECKS=true 且 PROBE_MAX_RISK ≥ 2/3）。
# 每个产品探测器均包含 SSRF、SQL 注入和 RCE Spec；以下开关用于启用它们。
# 默认关闭。除非已获准执行主动利用，否则请保持关闭。
PROBE_SSRF_ENABLED=false
PROBE_SQLI_ENABLED=false
PROBE_RCE_ENABLED=false

# ===== 调度器 =====
# 是否启用定期执行（true/false）
SCHEDULER_ENABLED=false

# 两次运行之间的间隔（秒）。3600 = 1 小时
SCHEDULER_INTERVAL=3600
# 用于全局扫描协调的 Redis 租约 TTL。持有者每隔 TTL/3 续租一次。
SCAN_LOCK_TTL=7200

# ===== Tavily（CVE 同步） =====
TAVILY_BASE_URL=https://tavily.astrdark.cyou
TAVILY_KEY=your_tavily_proxy_key

# ===== GPT 分析器（第三方 OpenAI 兼容 API） =====
GPT_BASE_URL=https://your-gpt-proxy.com/v1
GPT_KEY=sk-your-gpt-key
GPT_MODEL=gpt-4o-mini
# 快速模式：提高 GPT 提取批次的并发数
GPT_FAST=false
# 推理模型的 reasoning_effort（low|medium|high，设为 ""/none 则省略）。
# 快速模型（例如 grok-4.5）可使用 "high" 来提高提取准确率。
GPT_REASONING_EFFORT=high
# 复检并发数（用于验证复检的并行 GPT 调用数）
GPT_RECHECK_CONCURRENCY=10
# 复检批次大小（每次 GPT 调用的条目数，可减少 API 调用总数）
GPT_RECHECK_BATCH_SIZE=10
# GPT 提取与复检之间的冷却时间（秒），用于避免集中触发限流
GPT_RECHECK_COOLDOWN=5.0

# ===== 输出 =====
# JSON 结果目录
RESULTS_DIR=results

# ===== Web API（Axum 服务层，`aipocket serve`） =====
# Web UI 登录使用的全局密码。启动服务器时必须设置。
WEB_PASSWORD=change_me_to_a_strong_password
# 用于签发 JWT 会话令牌的 HMAC 密钥。必须设置，并使用足够长的随机字符串，
# 例如 `python -c "import secrets; print(secrets.token_urlsafe(48))"`。
WEB_JWT_SECRET=change_me_to_a_long_random_secret
# 会话令牌有效期（秒；默认 86400 = 24 小时）。
WEB_TOKEN_TTL=86400
# CORS 允许的源地址（逗号分隔）。本地开发可使用 "*"；生产环境应设置实际的
# 前端源地址，例如 https://app.example.com
WEB_CORS_ORIGINS=*
# 原生发布包内置前端静态文件目录；从其他工作目录启动时请改为绝对路径。
WEB_STATIC_DIR=web
# 内存中的滚动扫描日志窗口（为 SSE 重放和轮询保留的行数）。
WEB_LOG_BUFFER_LINES=2000

# ===== 跨运行去重（Redis） =====
# 设为 true 时，会跳过此前运行中已处理的主机/凭据（成功的验证会被缓存并复用；
# 失败结果使用较短的 TTL，以便稍后重试）。Redis 不可用时，扫描会自动回退至
# 原有的无去重行为。设置 DEDUP_ENABLED=false 可完全禁用。
DEDUP_ENABLED=true
DEDUP_REDIS_URL=redis://localhost:6379/0
# TTL 单位为秒。默认值：主机=7 天，凭据=3 天，确定性拒绝=30 天，
# 瞬时失败=6 小时，余额=1 天。
DEDUP_HOST_TTL=604800
DEDUP_CRED_TTL=259200
DEDUP_REJECTED_TTL=2592000
DEDUP_TRANSIENT_TTL=21600
DEDUP_BALANCE_TTL=86400

# ===== PostgreSQL（持久化权威数据源） =====
# 扫描结果、高价值密钥和 CVE 存储使用的 libpq 连接 URL。
# 留空则继续仅使用 JSONL 文件（原有行为）；设置后启用 PostgreSQL。
# 在 docker-compose 中，此地址指向随附的 `postgres` 服务。
#   postgresql://aipocket:aipocket@localhost:5432/aipocket
DATABASE_URL=
# 连接池大小。
PG_POOL_MIN=2
PG_POOL_MAX=10
# 迁移期双写：true 表示同时写入 PostgreSQL 和 JSONL（用于现有部署迁移时的
# 回填、验证和回滚）。默认为 false，表示 PostgreSQL 是唯一权威数据源。
# 仅在迁移期间设为 true。
PG_DUAL_WRITE=false

# ===== Shodan 配置（第二数据源） =====
# 逗号分隔的 Shodan API 密钥列表（轮换/故障回退）
# 可从 https://account.shodan.io 获取
SHODAN_KEYS=your_shodan_key_1,your_shodan_key_2

# Shodan REST API 的基础 URL（通常无需修改）
SHODAN_BASE_URL=https://api.shodan.io

# 每次查询的最大页数（Shodan 每页返回 100 条结果）。查询包含过滤器时，
# 1 页消耗 1 个查询积分；页数越高，覆盖越广，消耗的积分也越多。
# 预算：每月 200000 个查询积分；1 个积分对应 100 条结果。
# 注意：结果量最大的产品查询会按国家分片（参见 shodan_queries.py 中的
# SHARD_PRODUCTS），因此设为 10 页可让每个分片最多获取 1000 条新结果，
# 而不会在前 100 条处截断。
SHODAN_MAX_PAGES=10

# 每个产品查询分配给国家分片的 Shodan 首页积分上限。
SHODAN_CREDIT_BUDGET=8

# 请求超时时间（秒）
SHODAN_TIMEOUT=30

# 分页请求间隔（秒）。Shodan 限流约为每秒 1 次请求。
SHODAN_PAGE_DELAY=1
